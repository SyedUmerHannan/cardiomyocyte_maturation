# Download human transcriptome (GENCODE, current release)
wget https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.transcripts.fa.gz

# Build salmon index
salmon index -t gencode.v46.transcripts.fa.gz -i ~/salmon_index -p 8

for srr in SRR9057278 SRR9057279 SRR9057280 SRR9057281; do
  salmon quant -i ~/salmon_index -l A \
    -r ~/fastq1/${srr}_1.fastq \
    -p 8 --validateMappings -o ~/salmon_out/${srr}
done

cd ~/fastq1  # or wherever your gencode.v46.transcripts.fa.gz is
wget https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/GRCh38.primary_assembly.genome.fa.gz

gunzip -k GRCh38.primary_assembly.genome.fa.gz
grep "^>" GRCh38.primary_assembly.genome.fa | sed 's/>//' | cut -d ' ' -f 1 > decoys.txt
wc -l decoys.txt 

cat gencode.v46.transcripts.fa.gz GRCh38.primary_assembly.genome.fa.gz > gentrome.fa.gz

salmon index \
  -t gentrome.fa.gz \
  -d decoys.txt \
  -i ~/salmon_index_decoy \
  -p 8 \
  --gencode \
  -k 31

for srr in SRR9057278 SRR9057279 SRR9057280 SRR9057281; do
  salmon quant -i ~/salmon_index_decoy -l A \
    -r ~/fastq1/${srr}_1.fastq \
    -p 8 --validateMappings --gcBias -o ~/salmon_out/${srr}
done
