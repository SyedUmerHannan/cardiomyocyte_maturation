%%bash
# Ubuntu ships HDF5 headers/libs under a "serial" subdir that CMake's
# find_package(HDF5) doesn't search by default. Symlink them into the
# standard include/lib paths so the build can find them.

HDF5_INCLUDE_DIR=$(dirname $(find /usr -iname "hdf5.h" 2>/dev/null | head -n1))
HDF5_LIB_DIR=$(dirname $(find /usr -iname "libhdf5.so" 2>/dev/null | head -n1))

echo "HDF5 include dir: $HDF5_INCLUDE_DIR"
echo "HDF5 lib dir: $HDF5_LIB_DIR"

# Symlink headers
for f in "$HDF5_INCLUDE_DIR"/*.h; do
    ln -sf "$f" "/usr/include/$(basename "$f")"
done

# Symlink libraries (both .so and versioned .so.x)
for f in "$HDF5_LIB_DIR"/libhdf5*; do
    ln -sf "$f" "/usr/lib/x86_64-linux-gnu/$(basename "$f")"
done

echo "----- Verifying symlinks -----"
ls -la /usr/include/hdf5.h
ls -la /usr/lib/x86_64-linux-gnu/libhdf5.so

