from Bio import SeqIO
import os
import gzip # Import the gzip module
import io # Import io module for TextIOWrapper

# Ensure INDEX_DIR is defined from previous cells
# INDEX_DIR = "/content/drive/MyDrive/Research/Cardiac Maturation AI/reference"

# Path to the downloaded gencode reference file
GENCODE_FASTA = f"{INDEX_DIR}/gencode.v46.transcripts.fa.gz"
TX2GENE_FILE = f"{INDEX_DIR}/gencode_v46_tx2gene.tsv"

print(f"Generating tx2gene map for {GENCODE_FASTA} to {TX2GENE_FILE}...")

tx2gene_entries = []
# Open the gzipped file in binary mode ('rb')
with gzip.open(GENCODE_FASTA, "rb") as fh_gz:
    # Wrap the binary stream in a TextIOWrapper to provide a text stream to SeqIO.parse
    fasta_text_handle = io.TextIOWrapper(fh_gz, encoding='utf-8')
    with open(TX2GENE_FILE, "w") as outfile:
        for record in SeqIO.parse(fasta_text_handle, "fasta"):
            transcript_id = record.id.split(".")[0] # e.g., ENST00000456328.2 -> ENST00000456328

            # Extract gene_id from description or header
            # Example header: >ENST00000456328.2|ENSG00000223972.5|OTTHUMT00000362751.1|OTTHUMG00000085871.4|DDX11L1-202|DDX11L1|1657|processed_transcript|1|\
            description_parts = record.description.split("|")
            gene_id = None
            for part in description_parts:
                if part.startswith("ENSG"):
                    gene_id = part.split(".")[0] # e.g., ENSG00000223972.5 -> ENSG00000223972
                    break

            if gene_id:
                tx2gene_entries.append(f"{transcript_id}\t{gene_id}\n")

        outfile.writelines(tx2gene_entries)

print(f"Created tx2gene mapping file: {TX2GENE_FILE} with {len(tx2gene_entries)} entries.")

# Verify the first few lines
with open(TX2GENE_FILE, 'r') as f:
    for i, line in enumerate(f):
        if i >= 5: # Print first 5 lines
            break
        print(line.strip())

import re, os
from collections import defaultdict

fastq_files = sorted(os.listdir(FASTQ_DIR))
samples = defaultdict(list)

for f in fastq_files:
    if not (f.endswith(".fastq.gz") or f.endswith(".fq.gz") or f.endswith(".fastq") or f.endswith(".fq")):
        continue
    m = re.match(r"(SRR\d+)(_[12])?\.(fastq|fq)(\.gz)?$", f)
    if m:
        srr = m.group(1)
        samples[srr].append(f)

for srr, files in samples.items():
    layout = "paired" if len(files) == 2 else "single"
    print(f"{srr}: {sorted(files)} -> {layout}-end")

KNOWN_GAPS_NOTE = "SRR9057279 flagged for low mapping rate previously (salmon, ~48%) due to stranded-forward chemistry / short reads (25-44bp) — re-check kallisto rate against this."

# Set fragment length assumptions for single-end mode (kallisto requires these).
# These are ESTIMATES since no fragment length distribution is known — flagged explicitly.
FRAG_LEN_MEAN = 200
FRAG_LEN_SD = 20

kallisto_bin = "/content/kallisto/build/src/kallisto"
index_path = f"{INDEX_DIR}/kallisto_index_k21.idx"

log_lines = []

for srr, files in samples.items():
    out_dir = f"{RESULTS_DIR}/{srr}"
    os.makedirs(out_dir, exist_ok=True)
    files_sorted = sorted(files)
    file_paths = [f"{FASTQ_DIR}/{f}" for f in files_sorted]

    if len(files_sorted) == 2:
        # paired-end
        cmd = [
            kallisto_bin, "quant",
            "-i", index_path,
            "-o", out_dir,
            "-b", "0",          # no bootstraps by default; add -b 100 if needed for downstream uncertainty estimation
            file_paths[0], file_paths[1]
        ]
    else:
        # single-end — requires --single -l -s
        cmd = [
            kallisto_bin, "quant",
            "-i", index_path,
            "-o", out_dir,
            "--single",
            "-l", str(FRAG_LEN_MEAN),
            "-s", str(FRAG_LEN_SD),
            file_paths[0]
        ]

    print(f"Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    print(result.stdout)
    print(result.stderr)

    log_lines.append({
        "sample": srr,
        "layout": "paired" if len(files_sorted) == 2 else "single",
        "returncode": result.returncode,
        "stderr_tail": result.stderr[-500:] if result.stderr else ""
    })

print("All samples processed.")

import pandas as pd

log_df = pd.DataFrame(log_lines)
log_df["note"] = ""
log_df.loc[log_df["sample"] == "SRR9057279", "note"] = KNOWN_GAPS_NOTE
log_df["index_kmer"] = 21
log_df["reference"] = "GENCODE v46 transcript-only"
log_df["frag_len_mean_assumed"] = FRAG_LEN_MEAN
log_df["frag_len_sd_assumed"] = FRAG_LEN_SD

log_path = f"{RESULTS_DIR}/kallisto_run_log.csv"
log_df.to_csv(log_path, index=False)
print(f"Saved run log to {log_path}")
log_df

