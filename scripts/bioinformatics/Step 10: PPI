## ---- Cell 3: Build trusted leading-edge gene sets per contrast, intersect ----
import pandas as pd

BASE = "/content/drive/MyDrive/Research/Cardiac Maturation AI/Master Data/"

gsea_files = {
    "Maturing_vs_Embryonic": BASE + "step_gsea/Maturing_vs_Embryonic_Hallmark_GSEA.csv",
    "Adult_vs_Maturing":     BASE + "step_gsea/Adult_vs_Maturing_Hallmark_GSEA.csv",
    "Adult_vs_Embryonic":    BASE + "step_gsea/Adult_vs_Embryonic_Hallmark_GSEA.csv",
}

TRUSTED = ["Oxidative Phosphorylation", "Fatty Acid Metabolism", "Adipogenesis",
           "Glycolysis", "G2-M Checkpoint", "E2F Targets", "Mitotic Spindle"]

trusted_genes_per_contrast = {}
for label, path in gsea_files.items():
    df = pd.read_csv(path)
    df['NES'] = df['NES'].astype(float)
    sub = df[df['Term'].isin(TRUSTED)]
    genes = set()
    for _, row in sub.iterrows():
        genes.update(g.strip() for g in str(row['Lead_genes']).split(';') if g.strip())
    trusted_genes_per_contrast[label] = genes
    print(f"{label}: {len(genes)} trusted leading-edge genes ({sub.shape[0]}/{len(TRUSTED)} terms found)")

core_trusted = set.intersection(*trusted_genes_per_contrast.values())
print(f"\nCore trusted genes (in all 3 contrasts' trusted leading-edges): {len(core_trusted)}")
pd.DataFrame({"gene_symbol": sorted(core_trusted)}).to_csv(
    BASE + "step_results_figures/core_trusted_genes_all3contrasts.csv", index=False)

## ---- Cell 4: STRING network on confound-excluded core genes ----
import requests, time, networkx as nx

def get_string_network(gene_list, confidence=400, batch_size=300):
    edges = []
    for i in range(0, len(gene_list), batch_size):
        batch = gene_list[i:i+batch_size]
        params = {"identifiers":"%0d".join(batch), "species":9606,
                   "required_score":confidence, "network_type":"physical"}
        try:
            r = requests.get("https://string-db.org/api/tsv/network", params=params, timeout=60)
            r.raise_for_status()
            lines = r.text.strip().split("\n")
            if len(lines)>1:
                header = lines[0].split("\t")
                for line in lines[1:]:
                    edges.append(dict(zip(header, line.split("\t"))))
        except Exception as e:
            print(f"Batch failed: {e}")
        time.sleep(1)
    return pd.DataFrame(edges)

core_list = sorted(core_trusted)
edges_df = get_string_network(core_list)
if edges_df.shape[0] == 0:
    raise ValueError("HARD FAIL: zero edges returned.")

G = nx.Graph()
for _, row in edges_df.iterrows():
    G.add_edge(row['preferredName_A'], row['preferredName_B'])

print(f"Confound-excluded core network: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges")
edges_df.to_csv(BASE + "step_ppi_network/STRING_core_trusted_edges.csv", index=False)

## ---- Cell 5: Hub/bridge ranking + plot ----
import matplotlib.pyplot as plt

degree_cent = nx.degree_centrality(G)
betweenness = nx.betweenness_centrality(G)
hub_df = pd.DataFrame({
    "gene": list(degree_cent.keys()),
    "degree": [G.degree(g) for g in degree_cent],
    "betweenness": [betweenness[g] for g in degree_cent]
}).sort_values("degree", ascending=False)
hub_df.to_csv(BASE + "step_ppi_network/PPI_core_trusted_hubs.csv", index=False)

print("Top 15 by degree:")
print(hub_df.head(15).to_string(index=False))
print("\nTop 15 by betweenness:")
print(hub_df.sort_values("betweenness", ascending=False).head(15).to_string(index=False))

bridge_genes = hub_df.sort_values("betweenness", ascending=False).head(8)['gene'].tolist()
node_colors = ['#d62728' if n in bridge_genes else '#aec7e8' for n in G.nodes()]
node_sizes = [G.degree(n)*10 for n in G.nodes()]

fig, ax = plt.subplots(figsize=(10,10))
pos = nx.spring_layout(G, seed=42, k=0.15)
nx.draw_networkx_edges(G, pos, alpha=0.15, ax=ax)
nx.draw_networkx_nodes(G, pos, node_color=node_colors, node_size=node_sizes, ax=ax)
nx.draw_networkx_labels(G, pos, labels={n:n for n in bridge_genes}, font_size=9, font_weight='bold', ax=ax)
ax.set_title(f"Confound-excluded core PPI network ({G.number_of_nodes()} nodes)")
ax.axis('off')
plt.tight_layout()
plt.savefig(BASE + "step_results_figures/Fig8b_PPI_core_trusted_FIXED.png")
plt.show()
