## ---- Cell 5: Build ranked gene x stat Series for regulon scoring (same pattern as your GSEA step) ----
import mygene, time

mg = mygene.MyGeneInfo()

def batched_symbol_map(ensembl_ids, batch_size=300, max_retries=5):
    ensembl_ids = list(set(ensembl_ids))
    id2symbol = {}
    for i in range(0, len(ensembl_ids), batch_size):
        batch = ensembl_ids[i:i+batch_size]
        attempt = 0
        while attempt < max_retries:
            try:
                res = mg.querymany(batch, scopes="ensembl.gene", fields="symbol",
                                    species="human", returnall=False)
                for r in res:
                    if "symbol" in r:
                        id2symbol[r["query"]] = r["symbol"]
                break
            except Exception as e:
                attempt += 1
                wait = 2 ** attempt
                print(f"Batch failed (attempt {attempt}): {e}. Retrying in {wait}s...")
                time.sleep(wait)
    return id2symbol

id_col = "ensembl_id" if "ensembl_id" in de_full.columns else "gene_id"
id2symbol = batched_symbol_map(de_full[id_col].tolist())

de_full["symbol"] = de_full[id_col].map(id2symbol)
de_full["stat"] = pd.to_numeric(de_full["stat"], errors="coerce")
de_full = de_full.dropna(subset=["symbol","stat"])
de_full["abs_stat"] = de_full["stat"].abs()
de_full = de_full.sort_values("abs_stat", ascending=False).drop_duplicates("symbol", keep="first")

